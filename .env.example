# Optional: use pre-generated forecast images instead of rendering canvases
# in every visitor's browser.
NEXT_PUBLIC_FORECAST_ASSET_BASE_URL=

# Carto basemap API key. Without it, basemap tiles return 200 with an
# "API KEY REQUIRED" watermark burned into the image. Get one at
# carto.com/basemaps/apikey. Build-time: changing it needs a redeploy.
NEXT_PUBLIC_CARTO_API_KEY=
